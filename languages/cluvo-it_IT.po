#: includes/class-cluvo-settings.php:37 includes/class-cluvo-settings.php:38
#: includes/class-cluvo-settings.php:165
msgid "Cluvo"
msgstr "Cluvo"

#: includes/class-cluvo-settings.php:46
msgid "Einstellungen"
msgstr "Impostazioni"

#: includes/class-cluvo-settings.php:75
msgid "Verbindung wird geprüft …"
msgstr "Verifica della connessione …"

#: includes/class-cluvo-settings.php:76
msgid "Die Prüfung ist fehlgeschlagen. Bitte versuche es erneut."
msgstr "La verifica non è riuscita. Riprova."

#: includes/class-cluvo-settings.php:77 includes/class-cluvo-settings.php:318
msgid "Bitte zuerst einen API-Key eintragen."
msgstr "Inserisci prima una chiave API."

#: includes/class-cluvo-settings.php:78
msgid "Speichere die Einstellungen, damit der Verein eine ID bekommt."
msgstr "Salva le impostazioni affinché l’associazione riceva un ID."

#. translators: %s: name of the Verein
#: includes/class-cluvo-settings.php:127
#, php-format
msgid "Für «%s» fehlt der API-Key."
msgstr "Manca la chiave API per «%s»."

#: includes/class-cluvo-settings.php:169
msgid "Der Cache wurde geleert."
msgstr "La cache è stata svuotata."

#: includes/class-cluvo-settings.php:172
msgid "Verbinde diese Webseite mit einem oder mehreren Cluvo-Vereinen. Einen API-Key erstellst du in Cluvo unter Einstellungen → Integration."
msgstr "Collega questo sito a una o più associazioni Cluvo. Crei una chiave API in Cluvo sotto Impostazioni → Integrazione."

#: includes/class-cluvo-settings.php:177
msgid "Vereine"
msgstr "Associazioni"

#: includes/class-cluvo-settings.php:178
msgid "Jeder Verein hat einen eigenen API-Key. Die ID nutzt du im Shortcode, z.B. account=\"1\". Gespeicherte Keys werden nicht mehr angezeigt – lässt du das Feld leer, bleibt der Key erhalten."
msgstr "Ogni associazione ha la propria chiave API. Usa l’ID nello shortcode, ad es. account=\"1\". Le chiavi salvate non vengono più mostrate – se lasci vuoto il campo, la chiave resta invariata."

#: includes/class-cluvo-settings.php:183
msgid "ID"
msgstr "ID"

#: includes/class-cluvo-settings.php:184 includes/class-cluvo-settings.php:284
msgid "Name"
msgstr "Nome"

#: includes/class-cluvo-settings.php:185 includes/class-cluvo-settings.php:288
msgid "API-Key"
msgstr "Chiave API"

#: includes/class-cluvo-settings.php:186
msgid "Aktionen"
msgstr "Azioni"

#: includes/class-cluvo-settings.php:202
msgid "+ Verein hinzufügen"
msgstr "+ Aggiungi associazione"

#: includes/class-cluvo-settings.php:207
msgid "Cache-Dauer (Sekunden)"
msgstr "Durata della cache (secondi)"

#: includes/class-cluvo-settings.php:210
msgid "So lange werden Formulare, Veranstaltungen und News zwischengespeichert. Ist Cluvo nicht erreichbar, zeigt das Plugin bis zu einem Tag lang den letzten Stand."
msgstr "Durata della cache per moduli, eventi e notizie. Se Cluvo non è raggiungibile, il plugin mostra l’ultimo stato noto per al massimo un giorno."

#: includes/class-cluvo-settings.php:222
msgid "Cache leeren"
msgstr "Svuota cache"

#: includes/class-cluvo-settings.php:223
msgid "Änderungen aus Cluvo sofort anzeigen."
msgstr "Mostra subito le modifiche fatte in Cluvo."

#: includes/class-cluvo-settings.php:228
msgid "Shortcodes"
msgstr "Shortcode"

#: includes/class-cluvo-settings.php:229
msgid "Ist nur ein Verein hinterlegt, kann account=\"…\" weggelassen werden. «Testen» zeigt die Shortcodes der aktiven Formulare eines Vereins."
msgstr "Se è configurata una sola associazione, account=\"…\" può essere omesso. «Verifica» mostra gli shortcode dei moduli attivi di un’associazione."

#: includes/class-cluvo-settings.php:234
msgid "Shortcode"
msgstr "Shortcode"

#: includes/class-cluvo-settings.php:235
msgid "Attribute"
msgstr "Attributi"

#: includes/class-cluvo-settings.php:241
msgid "<code>slug</code> – Slug des Formulars in Cluvo (Pflicht)"
msgstr "<code>slug</code> – slug del modulo in Cluvo (obbligatorio)"

#: includes/class-cluvo-settings.php:245
msgid "<code>limit</code> – Anzahl Termine (Serien einzeln gezählt, Standard 10) · <code>category</code> – ID der Kategorie · <code>from</code>, <code>to</code> – Zeitraum als JJJJ-MM-TT (Standard: ab heute für 12 Monate)"
msgstr "<code>limit</code> – numero di date (serie contate singolarmente, predefinito 10) · <code>category</code> – ID della categoria · <code>from</code>, <code>to</code> – periodo nel formato AAAA-MM-GG (predefinito: da oggi per 12 mesi)"

#: includes/class-cluvo-settings.php:249
msgid "<code>limit</code> – Anzahl pro Seite (Standard 6, höchstens 50) · <code>category</code> – ID der Kategorie · <code>pagination=\"1\"</code> – Links zu älteren News"
msgstr "<code>limit</code> – numero per pagina (predefinito 6, al massimo 50) · <code>category</code> – ID della categoria · <code>pagination=\"1\"</code> – link alle notizie meno recenti"

