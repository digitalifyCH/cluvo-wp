msgid "Es ist noch kein Cluvo-Verein hinterlegt."
msgstr "Non è ancora configurata nessuna associazione Cluvo."

#. translators: %s: account id from the shortcode
#: includes/class-cluvo-client.php:98
#, php-format
msgid "Unbekannter Verein (account=\"%s\")."
msgstr "Associazione sconosciuta (account=\"%s\")."

#: includes/class-cluvo-client.php:107
msgid "Es sind mehrere Vereine hinterlegt – bitte account=\"…\" im Shortcode angeben."
msgstr "Sono configurate più associazioni – indica account=\"…\" nello shortcode."

#: includes/class-cluvo-client.php:146 includes/class-cluvo-client.php:245
msgid "Unbekannter oder unvollständiger Verein."
msgstr "Associazione sconosciuta o incompleta."

#. translators: %s: technical error message
#: includes/class-cluvo-client.php:177
#, php-format
msgid "Cluvo ist nicht erreichbar (%s)."
msgstr "Cluvo non è raggiungibile (%s)."

#: includes/class-cluvo-client.php:190
msgid "Der API-Key ist ungültig oder wurde in Cluvo widerrufen."
msgstr "La chiave API non è valida o è stata revocata in Cluvo."

#: includes/class-cluvo-client.php:192
msgid "Kein Zugriff auf die Cluvo-API."
msgstr "Nessun accesso all’API di Cluvo."

#: includes/class-cluvo-client.php:194
msgid "Nicht gefunden. Ist der Slug richtig und das Formular bzw. der Artikel in Cluvo aktiv und öffentlich?"
msgstr "Non trovato. Lo slug è corretto e il modulo o l’articolo è attivo e pubblico in Cluvo?"

#: includes/class-cluvo-client.php:196
msgid "Zu viele Anfragen an Cluvo. Bitte versuche es gleich nochmals."
msgstr "Troppe richieste a Cluvo. Riprova tra poco."

