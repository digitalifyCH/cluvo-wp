#: includes/class-cluvo-settings.php:241
msgid "<code>slug</code> – Slug des Formulars in Cluvo (Pflicht)"
msgstr "<code>slug</code> – slug du formulaire dans Cluvo (obligatoire)"

#: includes/class-cluvo-settings.php:245
msgid "<code>limit</code> – Anzahl Termine (Serien einzeln gezählt, Standard 10) · <code>category</code> – ID der Kategorie · <code>from</code>, <code>to</code> – Zeitraum als JJJJ-MM-TT (Standard: ab heute für 12 Monate)"
msgstr "<code>limit</code> – nombre de dates (séries comptées individuellement, 10 par défaut) · <code>category</code> – ID de la catégorie · <code>from</code>, <code>to</code> – période au format AAAA-MM-JJ (par défaut : dès aujourd’hui pour 12 mois)"

#: includes/class-cluvo-settings.php:249
msgid "<code>limit</code> – Anzahl pro Seite (Standard 6, höchstens 50) · <code>category</code> – ID der Kategorie · <code>pagination=\"1\"</code> – Links zu älteren News"
msgstr "<code>limit</code> – nombre par page (6 par défaut, 50 au maximum) · <code>category</code> – ID de la catégorie · <code>pagination=\"1\"</code> – liens vers les actualités plus anciennes"

